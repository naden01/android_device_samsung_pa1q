+	// WIP148: force_writable + size-guard for writing an image into a READ-ONLY super
+	// sub-partition (dm-N over sda31) or super itself. TWRP maps every dynamic partition
+	// (system/vendor/product/system_ext/system_dlkm/vendor_dlkm/odm) as a read-only
+	// dm-linear device, so a raw write returns EPERM ("Operation not permitted") - which
+	// is why restoring/flashing these images fails. This runs ONLY on a WRITE (PM_BACKUP
+	// only reads, always allowed) and ONLY when destfn is a block device the kernel reports
+	// read-only (BLKROGET). Two steps:
+	//   1. SIZE-GUARD: a dd write cannot resize the extent (only fastbootd/liblp can). If
+	//      the image is LARGER than the device it would overflow the extent boundary and
+	//      corrupt the neighbouring partition inside super -> refuse instead.
+	//   2. BLKROSET 0: clear the read-only flag on THIS device only, for this write. The
+	//      caller (Restore_Image/Flash_Image, patch 0013) already tore down the decrypt
+	//      stack for vendor/system so the target is unmounted; a reboot follows and the
+	//      flag reverts on the next TWRP boot, so it never persists. Physical writable
+	//      partitions (boot/modem/optics/... ) are not read-only here, so this is a no-op
+	//      for them - they restore/flash exactly as before.
+	if (part_settings->PM_Method != PM_BACKUP && !part_settings->adbbackup) {
+		int rfd = open(destfn.c_str(), O_RDONLY | O_CLOEXEC);
+		if (rfd >= 0) {
+			int is_ro = 0;
+			if (ioctl(rfd, BLKROGET, &is_ro) == 0 && is_ro) {
+				unsigned long long dev_sz = TWFunc::IOCTL_Get_Block_Size(destfn.c_str());
+				if (dev_sz && Remain > dev_sz) {
+					gui_print_color("error", "Image (%llu MB) is larger than partition '%s' (%llu MB). Use fastbootd to flash a larger image.\n",
+						(unsigned long long)(Remain / 1048576ULL), Mount_Point.c_str(), (unsigned long long)(dev_sz / 1048576ULL));
+					close(rfd);
+					return false;
+				}
+				int off = 0;
+				if (ioctl(rfd, BLKROSET, &off) == 0)
+					LOGINFO("WIP148: cleared read-only on '%s' for image write (img=%llu dev=%llu bytes)\n", destfn.c_str(), (unsigned long long)Remain, dev_sz);
+				else
+					LOGINFO("WIP148: BLKROSET failed on '%s': %s\n", destfn.c_str(), strerror(errno));
+			}
+			close(rfd);
+		}
+	}
+
