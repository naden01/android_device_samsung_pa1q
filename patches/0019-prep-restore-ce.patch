+// WIP165 (Plan B+): prepare the CE layer BEFORE the destructive restore, so the PIN can be
+// validated up-front (in the GUI caller thread) instead of failing mid-restore with ENOKEY.
+// Mirrors the staged preload of Restore_Tar() but WITHOUT wiping /data: it brings the A16
+// decrypt stack up (pre_restore_data.sh builds dm-default-key + installs the DE keys), then
+// uses twrpTar::extractGlob to pull ONLY the key material + spblob + weaver marker out of the
+// backup archive onto the LIVE /data (any archive type: single/split/compressed/encrypted,
+// because extractGlob reuses the native tar open path). With the marker present it is then
+// safe to start decrypt-hermes (IWeaver) - it will NOT wipe the eSE. After this returns the
+// live /data holds locksettings.db + spblob/* + persistent.sqlite, hermes is up, and
+// /system/bin/password '<pin>' can validate the credential against the eSE.
+// Returns:  1 = prepared AND the backup carries a lockscreen credential (.pwd) -> caller must prompt PIN
+//           0 = prepared but NO credential in the backup (empty LSKF) -> caller can restore with no PIN
+//          -1 = prep failed (stack/extract error) -> caller should abort
+int TWPartition::Prep_Restore_CE(PartitionSettings *part_settings) {
+	if (Mount_Point != "/data" || Key_Directory.empty()) {
+		LOGINFO("WIP165: Prep_Restore_CE: not a metadata-encrypted /data - nothing to prep\n");
+		return 0;
+	}
+	// 1) Bring up dm-default-key + DE keys (idempotent; safe to re-run). This mounts /data on
+	//    the dm-default-key device so the extracted spblob lands on the real fscrypt mount.
+	string hook = "/system/bin/pre_restore_data.sh";
+	if (TWFunc::Path_Exists(hook)) {
+		string result;
+		int ret = TWFunc::Exec_Cmd(hook, result, true);
+		if (ret != 0) {
+			LOGERR("WIP165: pre_restore_data.sh failed (exit %d):\n%s\n", ret, result.c_str());
+			return -1;
+		}
+		Find_Actual_Block_Device();
+	}
+	// 2) extractGlob the key material + spblob onto the LIVE /data, in dependency order, running
+	//    de_keyinstall after each layer so the next layer's dirs are readable. This is the same
+	//    domino as Restore_Tar's staged preload, but here /data was NOT wiped - we only ADD the
+	//    small key/spblob trees so de_keyinstall can walk DK -> DE0 -> CE material.
+	string Full_FileName = part_settings->Backup_Folder + "/" + Backup_FileName;
+	twrpTar tar;
+	tar.part_settings = part_settings;
+	tar.setdir(Mount_Point);
+	tar.setfn(Full_FileName);
+	tar.backup_name = Backup_Name;
+#ifndef TW_EXCLUDE_ENCRYPTED_BACKUPS
+	string Password;
+	DataManager::GetValue("tw_restore_password", Password);
+	if (!Password.empty())
+		tar.setpassword(Password);
+#endif
+	string de_keyinstall = "/system/bin/run_de_keyinstall.sh";
+	string kresult;
+	std::vector<std::string> stage;
+	// Stage 1: DK
+	stage.clear(); stage.push_back("unencrypted/");
+	tar.extractGlob(stage);
+	if (TWFunc::Path_Exists(de_keyinstall)) { TWFunc::Exec_Cmd(de_keyinstall, kresult, true); }
+	// Stage 2: DE0 + keystore + CE material under /data/misc
+	stage.clear(); stage.push_back("misc/");
+	tar.extractGlob(stage);
+	if (TWFunc::Path_Exists(de_keyinstall)) { TWFunc::Exec_Cmd(de_keyinstall, kresult, true); }
+	// Stage 3: CE spblob (system_de/) + locksettings.db (system/) + weaver_support marker (vendor/)
+	stage.clear(); stage.push_back("system_de/"); stage.push_back("system/"); stage.push_back("vendor/gatekeeper/");
+	tar.extractGlob(stage);
+	// 3) With /data/vendor/gatekeeper/.weaver_support now present, start hermes (IWeaver) if it is
+	//    not already running. The marker makes hermesd skip the eSE (Weaver) wipe. Do NOT start
+	//    hermes before the marker exists - a coldboot-looking gatekeeper dir triggers an eSE wipe.
+	if (TWFunc::Path_Exists("/data/vendor/gatekeeper/.weaver_support")) {
+		string hstate;
+		TWFunc::Exec_Cmd("getprop init.svc.decrypt-hermes", hstate, true);
+		if (hstate.find("running") == string::npos) {
+			LOGINFO("WIP165: starting decrypt-hermes for PIN validation (marker present -> no eSE wipe)\n");
+			TWFunc::Exec_Cmd("setprop ctl.start decrypt-hermes", kresult, true);
+			for (int i = 0; i < 40; i++) {
+				usleep(100000);
+				TWFunc::Exec_Cmd("getprop init.svc.decrypt-hermes", hstate, true);
+				if (hstate.find("running") != string::npos) break;
+			}
+			LOGINFO("WIP165: decrypt-hermes state=%s\n", hstate.c_str());
+		}
+	} else {
+		LOGINFO("WIP165: WARN .weaver_support marker not extracted - hermes NOT started (would risk eSE wipe)\n");
+	}
+	// 4) Does the backup carry a real lockscreen credential? A .pwd in the extracted spblob means
+	//    PIN/password required; only .weaver/.spblob (no .pwd) = empty LSKF (no credential).
+	bool has_credential = false;
+	DIR* d = opendir("/data/system_de/0/spblob");
+	if (d) {
+		struct dirent* ent;
+		while ((ent = readdir(d)) != NULL) {
+			size_t len = strlen(ent->d_name);
+			if (len > 4 && strcmp(ent->d_name + len - 4, ".pwd") == 0) { has_credential = true; break; }
+		}
+		closedir(d);
+	}
+	LOGINFO("WIP165: Prep_Restore_CE done - backup %s a lockscreen credential\n",
+	        has_credential ? "HAS" : "has NO");
+	return has_credential ? 1 : 0;
+}
