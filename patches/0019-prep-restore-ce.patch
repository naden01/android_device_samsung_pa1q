+// WIP165 (Plan B+): build a minimal PartitionSettings for the /data backup and run the CE prep
+// (bring up the decrypt stack + extract spblob/key material + start hermes) BEFORE the
+// destructive restore, so the GUI can validate the PIN up front. Returns Prep_Restore_CE's
+// verdict: 1 = credential present (prompt PIN), 0 = no credential (restore straight),
+// -1 = prep failed. Runs in the GUI caller thread (no nandroid thread active yet).
+int TWPartitionManager::Prep_Restore_For_PIN(const string& Restore_Name) {
+	TWPartition* dat = Find_Partition_By_Path("/data");
+	if (dat == NULL) {
+		LOGINFO("WIP165: Prep_Restore_For_PIN: /data partition not found\n");
+		return -1;
+	}
+	PartitionSettings part_settings;
+	part_settings.Backup_Folder = Restore_Name;
+	part_settings.Part = dat;
+	part_settings.partition_count = 1;
+	part_settings.total_restore_size = 0;
+	part_settings.adbbackup = false;
+	part_settings.adb_compression = 0;
+	part_settings.generate_digest = false;
+	part_settings.PM_Method = PM_RESTORE;
+	ProgressTracking progress(0);
+	part_settings.progress = &progress;
+	return dat->Prep_Restore_CE(&part_settings);
+}
