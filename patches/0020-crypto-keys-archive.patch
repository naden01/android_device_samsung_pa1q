+// WIP166: after the main /data backup, write a small companion archive (<name>.<fs>.keys) with
+// ONLY the FBE crypto material, so a pre-restore PIN check can read it instantly instead of
+// scanning the whole split backup. The main archive is NOT touched. Non-fatal: if this fails the
+// backup still succeeds, and restore falls back to scanning the main archive (old behaviour).
+//
+// What goes in (see twrpTar::createKeysArchive for the "dir/" vs "dir" convention):
+//   unencrypted/                    - systemwide DE key (DK). NONE policy, readable first.
+//   misc, misc/vold                 - bare dir entries so their DE policy is recreated, not mkdir'd.
+//   misc/vold/user_keys/            - user-0 DE + CE key material (DE0/CE0).
+//   misc/keystore/                  - persistent.sqlite: the keystore2 blob that unwraps the SP.
+//   system_de, system_de/0          - bare dir entries (policy).
+//   system_de/0/spblob/             - synthetic-password protector: .pwd (the credential marker
+//                                     that tells us a PIN exists), .spblob, .weaver.
+//   system                          - bare dir entry, needed because locksettings.db lives in it.
+//   system/locksettings.db          - sp-handle -> names the spblob files + keystore alias.
+//   vendor, vendor/gatekeeper       - bare dir entries.
+//   vendor/gatekeeper/.weaver_support - marker that lets hermes start WITHOUT wiping the eSE.
+bool TWPartition::Backup_Crypto_Keys(PartitionSettings *part_settings) {
+	if (Mount_Point != "/data" || Key_Directory.empty()) {
+		return true;  // not a metadata-encrypted /data - nothing to do
+	}
+	if (part_settings->adbbackup) {
+		LOGINFO("WIP166: adb backup - skipping crypto keys archive\n");
+		return true;
+	}
+	// <backup>/<name>.<fs>.keys - a 4-char extension, which Set_Restore_Files() skips (it only
+	// accepts 3- or 6-char "win"/"win000"), so this file never shows up as a restorable partition.
+	string keys_fn = part_settings->Backup_Folder + "/" + Backup_Name + "." + Current_File_System + ".keys";
+	if (TWFunc::Path_Exists(keys_fn))
+		unlink(keys_fn.c_str());  // createTar() uses O_EXCL
+
+	// PRE-FLIGHT: twrpTar::tarList/createTar raise gui_err("Error creating backup.") on any
+	// failure, which would put a scary (and wrong) message on screen AFTER a successful backup.
+	// The realistic failure here is a full backup medium (we just wrote tens of GB to it), so
+	// bail out QUIETLY - log only - before touching libtar if there is not enough room. 64MB is
+	// far more than this archive needs (a few MB) but cheap insurance.
+	{
+		struct statfs sfs;
+		if (statfs(part_settings->Backup_Folder.c_str(), &sfs) == 0) {
+			unsigned long long freeb = (unsigned long long)sfs.f_bavail * (unsigned long long)sfs.f_bsize;
+			if (freeb < 67108864ULL) {
+				LOGINFO("WIP166: only %llu bytes free on the backup medium - skipping crypto keys archive (restore will fall back to scanning the main archive)\n", freeb);
+				return true;
+			}
+		}
+	}
+
+	std::vector<std::string> paths;
+	paths.push_back(Backup_Path + "/unencrypted/");
+	paths.push_back(Backup_Path + "/misc");
+	paths.push_back(Backup_Path + "/misc/vold");
+	paths.push_back(Backup_Path + "/misc/vold/user_keys/");
+	paths.push_back(Backup_Path + "/misc/keystore/");
+	paths.push_back(Backup_Path + "/system_de");
+	paths.push_back(Backup_Path + "/system_de/0");
+	paths.push_back(Backup_Path + "/system_de/0/spblob/");
+	paths.push_back(Backup_Path + "/system");
+	paths.push_back(Backup_Path + "/system/locksettings.db");
+	paths.push_back(Backup_Path + "/vendor");
+	paths.push_back(Backup_Path + "/vendor/gatekeeper");
+	paths.push_back(Backup_Path + "/vendor/gatekeeper/.weaver_support");
+
+	twrpTar keys;
+	keys.part_settings = part_settings;
+	keys.backup_exclusions = &backup_exclusions;  // honours patch 0012 (frp_secret) etc.
+	keys.setdir(Backup_Path);                     // root stripped from stored paths
+	keys.setfn(keys_fn);
+	keys.partition_name = Backup_Name;
+	keys.backup_folder = part_settings->Backup_Folder;
+	if (keys.createKeysArchive(paths) != 0) {
+		LOGINFO("WIP166: WARN could not create crypto keys archive '%s' - restore will fall back to scanning the main archive\n", keys_fn.c_str());
+		unlink(keys_fn.c_str());
+		return true;  // non-fatal by design
+	}
+	tw_set_default_metadata(keys_fn.c_str());
+	LOGINFO("WIP166: crypto keys archive written: %s (%llu bytes)\n", keys_fn.c_str(),
+	        (unsigned long long)TWFunc::Get_File_Size(keys_fn));
+	return true;
+}
