+// WIP166: create a small companion archive holding ONLY the crypto material needed to unlock
+// the CE layer at restore time (and to tell whether the backup is PIN-protected at all).
+// WHY: the main /data backup is split into ~40 x 1.5GB parts and libtar writes entries in
+// readdir order, so system_de/0/spblob - which carries the .pwd credential marker - can land
+// in a LATE part (observed: part 31 of 41 on a 60GB backup). A pre-restore PIN check then has
+// to scan ~46GB over USB-OTG before it can even tell whether a PIN is needed, which froze the
+// GUI for minutes. This archive puts all of that material in ONE few-MB file next to the main
+// backup, leaving the main archive untouched.
+// Path list convention:
+//   "path/"  -> add the entry AND recurse into it (dir entry + all contents)
+//   "path"   -> add exactly ONE entry: either a lone file, or a BARE directory entry that is
+//               needed only so libtar recreates that dir WITH its fscrypt policy (a bare
+//               mkdir would leave it unencrypted -> Android init "set_policy_failed" -> bootloop).
+// Uses the same libtar write path as the main backup (TWTAR_FLAGS), so pax fscrypt-policy
+// headers, SELinux contexts and POSIX capabilities are stored exactly as in the main archive.
+// Caller must set part_settings, backup_exclusions, setdir() and setfn() first.
+// Returns 0 on success, non-zero on failure (caller should treat it as non-fatal).
+int twrpTar::createKeysArchive(const std::vector<std::string>& paths) {
+	std::vector<TarListStruct> FileList;
+	struct TarListStruct TarItem;
+	unsigned long long target_size = 0;
+	unsigned local_thread_id = 0;
+	struct stat st;
+
+	if (backup_exclusions == NULL) {
+		LOGINFO("createKeysArchive: backup_exclusions is NULL\n");
+		return -1;
+	}
+	for (size_t i = 0; i < paths.size(); ++i) {
+		string p = paths[i];
+		bool recurse = (!p.empty() && p[p.size() - 1] == '/');
+		if (recurse)
+			p.erase(p.size() - 1);
+		if (lstat(p.c_str(), &st) != 0)
+			continue;  // absent on this device (e.g. no .weaver_support / empty-LSKF) - skip
+		// The entry itself always goes in FIRST so the dir is recreated with its policy.
+		TarItem.fn = p;
+		TarItem.thread_id = 0;
+		FileList.push_back(TarItem);
+		if (recurse && S_ISDIR(st.st_mode)) {
+			// target_size stays 0 so Generate_TarList never bumps the thread id: one thread,
+			// one archive, no splitting - this file must stay a single readable archive.
+			if (Generate_TarList(p, &FileList, &target_size, &local_thread_id) < 0) {
+				LOGINFO("createKeysArchive: Generate_TarList failed for '%s'\n", p.c_str());
+				return -1;
+			}
+		}
+	}
+	if (FileList.empty()) {
+		LOGINFO("createKeysArchive: nothing to archive\n");
+		return -1;
+	}
+	use_encryption = 0;
+	use_compression = 0;
+	split_archives = 0;      // MUST stay single: prep opens it as one archive
+	thread_id = 0;
+	progress_pipe_fd = -1;   // tiny archive: no progress reporting (writes to -1 are ignored)
+	ItemList = &FileList;
+	Total_Backup_Size = 0;
+	return tarList(&FileList, 0);
+}
