+int GUIAction::check_lockscreen_cred(std::string arg __unused) {
+	// WIP176: Android 17 (One UI 9) changed synthetic password structure - directory
+	// and file names are now encrypted. Check for subdirectories in /data/system_de/0/
+	// instead of .pwd files in the non-existent spblob/ directory.
+	int cred = 0;
+	DIR* dir = opendir("/data/system_de/0");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			const char* n = ent->d_name;
+			// Skip . and ..
+			if (strcmp(n, ".") == 0 || strcmp(n, "..") == 0) {
+				continue;
+			}
+			// Check if this is a directory (synthetic password blob container)
+			std::string full_path = std::string("/data/system_de/0/") + n;
+			struct stat st;
+			if (stat(full_path.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) {
+				// Found a subdirectory - indicates lockscreen credential exists
+				cred = 1;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	DataManager::SetValue("tw_has_lockscreen_cred", cred);
+	LOGINFO("check_lockscreen_cred: %d\n", cred);
+	return 0;
+}
