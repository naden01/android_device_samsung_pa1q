+int GUIAction::check_lockscreen_cred(std::string arg __unused) {
+	// Show "Decrypt Data" only when CE is credential-protected.
+	// A .pwd file in spblob means a lockscreen PIN/password is set.
+	// Biometric-only or no-lockscreen devices have no .pwd -> button hidden.
+	int cred = 0;
+	DIR* dir = opendir("/data/system_de/0/spblob");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			const char* n = ent->d_name;
+			size_t len = strlen(n);
+			if (len > 4 && strcmp(n + len - 4, ".pwd") == 0) {
+				cred = 1;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	DataManager::SetValue("tw_has_lockscreen_cred", cred);
+	LOGINFO("check_lockscreen_cred: %d\n", cred);
+	return 0;
+}
