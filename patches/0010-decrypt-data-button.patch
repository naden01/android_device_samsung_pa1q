+int GUIAction::check_lockscreen_cred(std::string arg __unused) {
+	// WIP112: set tw_has_lockscreen_cred=1 if spblob carries a .pwd protector.
+	// Called on mount-page entry so the Decrypt Data button appears only when
+	// there is actually a lockscreen credential to unlock. Biometric-only and
+	// no-lockscreen devices have no .pwd in spblob -> button stays hidden.
+	int cred = 0;
+	DIR* dir = opendir("/data/system_de/0/spblob");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			const char* n = ent->d_name;
+			size_t len = strlen(n);
+			if (len > 4 && strcmp(n + len - 4, ".pwd") == 0) {
+				cred = 1;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	DataManager::SetValue("tw_has_lockscreen_cred", cred);
+	LOGINFO("WIP112 check_lockscreen_cred: cred=%d\n", cred);
+	return 0;
+}
