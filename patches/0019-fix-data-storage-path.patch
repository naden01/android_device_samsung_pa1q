+// pa1q (WIP168): promote /data Storage_Path from "/data/media" to "/data/media/0" once
+// decrypt.sh has unlocked the CE layer.
+//
+// Setup_Data_Media() (partition.cpp) does this promotion itself, but only if
+// /data/media/0 exists at the moment it runs:
+//     Storage_Path = Mount_Point + "/media";              // /data/media
+//     Mount(false);
+//     if (TWFunc::Path_Exists(Mount_Point + "/media/0"))  // <- decides it
+//         Storage_Path = Mount_Point + "/media/0";
+// On this device it runs during the fstab parse, while /data is still encrypted - its
+// Mount(false) fails and the directory cannot exist yet, so Storage_Path stays at
+// "/data/media" for the rest of the session. Proven from a clean boot:
+//     recovery.log:148  Unable to mount '/data'
+//     recovery.log:151  Setting up '/data' as data/media emulated storage.
+//     recovery.log:152  Unable to mount '/data'
+//     recovery.log:831  Storage_Path: /data/media
+// Upstream repairs it inside Decrypt_Data() (see the /data/media/0 block further down this
+// file), but that path is never taken here: decrypt.sh performs the decryption and only then
+// sets ro.crypto.fs_crypto_blkdev, long after the fstab parse. So nothing ever re-evaluates
+// Storage_Path.
+//
+// Consequence: Add_Remove_MTP_Storage() copies Storage_Path into the MTP message, so MTP
+// exported "/data/media" and a Windows Explorer session showed the "0" and "obb"
+// subdirectories instead of the user's files. Fixing Storage_Path fixes MTP, the file browser
+// and the backup folder in one go.
+//
+// Triggered by the "fixstoragepath" ORS word, which decrypt.sh sends after the CE unlock -
+// the earliest moment /data/media/0 is actually reachable. MTP is not auto-started on this
+// device (tw_mtp_enabled is forced to 0 at boot), so simply correcting the field before the
+// user enables MTP is enough; no storage re-registration is needed.
+void TWPartitionManager::Fix_Data_Storage_Path(void) {
+	TWPartition* dat = Find_Partition_By_Path("/data");
+	if (dat == NULL) {
+		LOGINFO("Fix_Data_Storage_Path: no /data partition\n");
+		return;
+	}
+	if (!dat->Has_Data_Media) {
+		LOGINFO("Fix_Data_Storage_Path: /data is not data/media - skipped\n");
+		return;
+	}
+	if (dat->Storage_Path == "/data/media/0") {
+		LOGINFO("Fix_Data_Storage_Path: already /data/media/0 - nothing to do\n");
+		return;
+	}
+	if (!TWFunc::Path_Exists("/data/media/0")) {
+		LOGINFO("Fix_Data_Storage_Path: /data/media/0 not present yet - skipped\n");
+		return;
+	}
+	dat->Storage_Path = "/data/media/0";
+	dat->Symlink_Path = dat->Storage_Path;
+	DataManager::SetValue(TW_INTERNAL_PATH, "/data/media/0");
+	DataManager::SetValue("tw_storage_path", dat->Storage_Path);
+	LOGINFO("Fix_Data_Storage_Path: /data Storage_Path -> %s\n", dat->Storage_Path.c_str());
+	return;
+}
