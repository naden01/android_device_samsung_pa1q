--- a/gui/input.cpp
+++ b/gui/input.cpp
@@ -422,7 +422,17 @@
 	if (varName == mVariable) {
 		if (!isLocalChange) {
 			UpdateDisplayText();
+			// WIP153: the variable was changed EXTERNALLY (e.g. fbe_pin_validate clears
+			// tw_fbe_pin to "" after a wrong PIN). The stock code updated the text but left
+			// mCursorLocation pointing at the OLD position, so the cursor stayed stuck at the
+			// right edge over an now-empty field. Clamp the cursor when the value shrank/cleared
+			// and recompute cursorX (HandleCursorByText) like the varName.empty() branch does.
+			// -1 == end-of-string; for an empty displayValue HandleCursorByText puts cursorX at
+			// mRenderX (the left edge), so the cursor correctly jumps back to the start.
+			if (displayValue.empty() || (int)displayValue.size() < mCursorLocation)
+				mCursorLocation = -1;
 			HandleTextLocation(TW_INPUT_NO_UPDATE);
+			HandleCursorByText();
 		} else
 			isLocalChange = false;
 		return 0;
