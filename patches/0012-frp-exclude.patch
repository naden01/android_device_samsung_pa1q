--- a/partition.cpp
+++ b/partition.cpp
@@ -2799,6 +2799,15 @@
 			LOGINFO("WIP112: CE layer unlocked (/tmp/.ce_sp present) - backup allowed\n");
 	}
 
+	// WIP126: exclude the FRP credential file from /data backups. Restoring it on an
+	// unlocked-bootloader device makes frp_secret disagree with the live frp partition,
+	// which blocks lockscreen credential changes ("Cannot change credential while FRP
+	// is active"). TWRP only runs on unlocked bootloaders where FRP has zero value, so
+	// dropping it is safe. check_skip_dirs() runs for every entry (dirs AND files) in
+	// Generate_TarList(), so add_absolute_dir() matches this single file by exact path.
+	if (Mount_Point == "/data")
+		backup_exclusions.add_absolute_dir("/data/system/frp_secret");
+
 	TWFunc::GUI_Operation_Text(TW_BACKUP_TEXT, Backup_Display_Name, gui_parse_text("{@backing}"));
 	gui_msg(Msg("backing_up=Backing up {1}...")(Backup_Display_Name));
 
