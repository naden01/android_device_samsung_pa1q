+// WIP166: right after the main /data archive is written, emit a small companion archive
+// <name>.<fs>.keys holding ONLY the FBE crypto material.
+//
+// Why: Restore_Tar's staged preload must load DK -> DE0 -> CE0 BEFORE the main extract, and the
+// key material lives inside the backup. libtar cannot seek - tar_skip_regfile() (extract.c:292)
+// READS every skipped file's data block by block and throws it away - so each extractGlob() pass
+// physically reads the archive up to the entry it wants. On a 61GB / 41-part backup the spblob
+// sits in part 31, so stage 3 alone would read ~46GB from the (slow, ~25-30 MB/s) USB flash;
+// measured live, that scan instead aborted with rc=-1 and extracted 0 entries, which the caller
+// silently read as "backup has no credential" and the CE layer never came up.
+// Reading a ~2MB companion file makes the preload cost CONSTANT instead of proportional to the
+// backup size, and removes the split-part tail error along with the parts.
+//
+// Non-fatal by design: a missing/failed .keys file only means the preload falls back to scanning
+// the main archive (previous behaviour). It must never fail a completed backup.
+bool TWPartition::Backup_Crypto_Keys(PartitionSettings *part_settings) {
+	if (Mount_Point != "/data" || Key_Directory.empty())
+		return true;                        // only metadata-encrypted /data has FBE material
+	if (part_settings->adbbackup) {
+		LOGINFO("WIP166: adb backup - skipping keys archive\n");
+		return true;
+	}
+
+	string keys_fn = part_settings->Backup_Folder + "/" + Backup_Name + "." + Current_File_System + ".keys";
+
+	// Pre-flight free space. tarList() calls gui_err("Error creating backup.") on failure, which
+	// would put a FALSE error on screen after an otherwise successful backup - so bail quietly.
+	struct statfs fss;
+	if (statfs(part_settings->Backup_Folder.c_str(), &fss) == 0) {
+		unsigned long long freebytes = (unsigned long long)fss.f_bavail * (unsigned long long)fss.f_bsize;
+		if (freebytes < 64ULL * 1024ULL * 1024ULL) {
+			LOGINFO("WIP166: only %llu bytes free in '%s' - skipping keys archive\n",
+			        freebytes, part_settings->Backup_Folder.c_str());
+			return true;
+		}
+	}
+
+	std::vector<std::string> paths;
+	// --- DK layer: plaintext-at-rest, no policy ---
+	paths.push_back("/data/unencrypted/");
+	// --- DE0 + CE0 key blobs (DK-encrypted) ---
+	paths.push_back("/data/misc");                          // bare: policy carrier
+	paths.push_back("/data/misc/vold");                     // bare: policy carrier
+	paths.push_back("/data/misc/vold/user_keys/");          // de/0 (DE0) + ce/0/current (CE0)
+	paths.push_back("/data/misc/keystore/");                // persistent.sqlite = outer spblob layer
+	// --- CE0: sp-handle + synthetic-password blobs ---
+	paths.push_back("/data/system");                        // bare: WITHOUT this the main pass
+	                                                        // hits EEXIST on an unencrypted dir
+	                                                        // -> set_policy_failed -> bootloop
+	paths.push_back("/data/system/locksettings.db");         // sp-handle -> spblob file names
+	paths.push_back("/data/system_de");                     // bare: policy carrier
+	paths.push_back("/data/system_de/0");                   // bare: policy carrier
+	paths.push_back("/data/system_de/0/spblob/");            // <handle>.pwd/.spblob/.weaver
+	// --- IWeaver gate: hermes refuses to start without this and CE stays locked ---
+	paths.push_back("/data/vendor");                        // bare: policy carrier
+	paths.push_back("/data/vendor/gatekeeper");             // bare: policy carrier
+	paths.push_back("/data/vendor/gatekeeper/.weaver_support");
+	paths.push_back("/data/vendor/gatekeeper/.coldboot");    // fallback marker (decrypt.sh:720)
+
+	twrpTar keys_tar;
+	keys_tar.part_settings = part_settings;
+	keys_tar.setdir(Backup_Path);
+	keys_tar.setfn(keys_fn);
+	keys_tar.backup_name = Backup_Name;
+	keys_tar.partition_name = Backup_Name;
+	keys_tar.backup_folder = part_settings->Backup_Folder;
+	keys_tar.backup_exclusions = &backup_exclusions;
+
+	if (keys_tar.createKeysArchive(paths) != 0) {
+		LOGINFO("WIP166: keys archive '%s' FAILED - restore will fall back to scanning the main archive\n",
+		        keys_fn.c_str());
+		unlink(keys_fn.c_str());            // do not leave a truncated file: it would be trusted
+		return true;                        // non-fatal
+	}
+	tw_set_default_metadata(keys_fn.c_str());
+	LOGINFO("WIP166: keys archive written: '%s'\n", keys_fn.c_str());
 	return true;
 }
 
