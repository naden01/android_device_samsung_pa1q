+// WIP166: build a small companion archive with ONLY the crypto material needed to bring the
+// three FBE layers online (DK -> DE0 -> CE0). Written through the SAME libtar path as the main
+// backup (TWTAR_FLAGS), so the pax fscrypt-policy headers and SELinux contexts are preserved -
+// a shell tar would drop them and the restored dirs would come back unencrypted
+// (Android init "set_policy_failed:/data/system" -> bootloop).
+//
+// Path convention:
+//   "dir/"  -> add the dir entry AND recurse into it
+//   "dir"   -> add EXACTLY ONE entry (a bare dir, or a single file)
+// The bare-dir form matters: Generate_TarList lists a directory's CONTENTS but never the
+// directory itself, so without an explicit entry libtar would recreate the parent with a plain
+// mkdir - no fscrypt policy - and the main pass then hits EEXIST and skips the policy.
+//
+// Paths must be ABSOLUTE: tarList() lstat()s each entry by its stored fn, and TWRP's cwd is "/".
+// split_archives=0 forces include_root_dir=false in tarList(), so addFile() runs the stored
+// "/data/misc/..." through Strip_Root_Dir() and the ARCHIVE path becomes "/misc/..." - exactly
+// what extractGlob()'s normalisation (strip leading '/', then a leading "data/") expects.
+// Returns 0 on success, -1 on failure.
+int twrpTar::createKeysArchive(const std::vector<std::string>& paths) {
+	std::vector<TarListStruct> FileList;
+	struct TarListStruct TarItem;
+	unsigned long long target_size = 0;
+	unsigned local_thread_id = 0;
+	struct stat st;
+
+	if (backup_exclusions == NULL) {
+		LOGINFO("createKeysArchive: backup_exclusions is NULL\n");
+		return -1;
+	}
+
+	for (size_t i = 0; i < paths.size(); ++i) {
+		string p = paths[i];
+		bool recurse = (!p.empty() && p[p.size() - 1] == '/');
+		if (recurse)
+			p.erase(p.size() - 1);
+		if (lstat(p.c_str(), &st) != 0)
+			continue;                       // absent on this device - skip, not an error
+		TarItem.fn = p;
+		TarItem.thread_id = 0;
+		FileList.push_back(TarItem);        // the entry itself (carries the fscrypt policy)
+		if (recurse && S_ISDIR(st.st_mode)) {
+			if (Generate_TarList(p, &FileList, &target_size, &local_thread_id) < 0) {
+				LOGINFO("createKeysArchive: Generate_TarList failed for '%s'\n", p.c_str());
+				return -1;
+			}
+		}
+	}
+
+	if (FileList.empty()) {
+		LOGINFO("createKeysArchive: nothing to archive\n");
+		return -1;
+	}
+
+	use_encryption = 0;
+	userdata_encryption = 0;
+	use_compression = 0;
+	split_archives = 0;                     // single file; also -> include_root_dir=false
+	thread_id = 0;
+	progress_pipe_fd = -1;                  // in-process, no progress pipe
+	ItemList = &FileList;
+	Total_Backup_Size = 0;
+
+	LOGINFO("createKeysArchive: %zu entries -> '%s'\n", FileList.size(), tarfn.c_str());
+	return tarList(&FileList, 0);
+}
