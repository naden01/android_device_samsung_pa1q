+
+// WIP126: Decide whether a backup needs a lockscreen credential before it starts.
+// Runs in the CALLER thread so gui_changePage is safe. If the CE layer is already
+// unlocked this session (/tmp/.ce_sp present) go straight to the backup page. Else,
+// if the live spblob carries a .pwd protector, CE is locked -> prompt for the PIN so
+// de_keyinstall can unlock it before the tar run. Biometric-only / no-lock -> straight in.
+int GUIAction::fbe_backup_pin_check(std::string arg __unused)
+{
+	DataManager::SetValue("tw_fbe_pin", "");
+	DataManager::SetValue("tw_password_fail", 0);
+	if (TWFunc::Path_Exists("/tmp/.ce_sp")) {
+		LOGINFO("WIP126: fbe_backup_pin_check: CE already unlocked -> backup\n");
+		gui_changePage("backup");
+		return 0;
+	}
+	bool has_credential = false;
+	DIR* dir = opendir("/data/system_de/0/spblob");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			size_t len = strlen(ent->d_name);
+			if (len > 4 && strcmp(ent->d_name + len - 4, ".pwd") == 0) {
+				has_credential = true;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	if (has_credential) {
+		LOGINFO("WIP126: fbe_backup_pin_check: credential present -> PIN page\n");
+		DataManager::SetValue("tw_fbe_pin_mode", 1); // 1 = backup destination
+		gui_changePage("fbe_backup_pin");
+	} else {
+		LOGINFO("WIP126: fbe_backup_pin_check: no credential -> backup\n");
+		gui_changePage("backup");
+	}
+	return 0;
+}
+
+// WIP126: Validate the PIN/password from fbe_restore_pin or fbe_backup_pin against the
+// LIVE /data via the password helper (same path as the Decrypt Data button). Instant
+// verdict: rc==0 -> route by tw_fbe_pin_mode (0 restore_run, 1 backup); rc!=0 -> set
+// tw_password_fail=1 and stay on the page (error label shows). Scrub the PIN afterwards.
+int GUIAction::fbe_pin_validate(std::string arg __unused)
+{
+	string pin;
+	DataManager::GetValue("tw_fbe_pin", pin);
+	string escaped;
+	for (size_t i = 0; i < pin.size(); ++i) {
+		if (pin[i] == '\'') escaped += "'\\''";
+		else escaped += pin[i];
+	}
+	LOGINFO("WIP126: fbe_pin_validate: validating credential (len=%zu)\n", pin.size());
+	int rc = TWFunc::Exec_Cmd("/system/bin/password '" + escaped + "'", true);
+	if (rc == 0) {
+		DataManager::SetValue("tw_password_fail", 0);
+		int mode = 0;
+		DataManager::GetValue("tw_fbe_pin_mode", mode);
+		LOGINFO("WIP126: fbe_pin_validate: OK (mode=%d)\n", mode);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+		if (mode == 1)
+			gui_changePage("backup");
+		else
+			gui_changePage("restore_run");
+	} else {
+		DataManager::SetValue("tw_password_fail", 1);
+		LOGINFO("WIP126: fbe_pin_validate: WRONG PIN (rc=%d) -> stay\n", rc);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+	}
+	return 0;
+}
 
