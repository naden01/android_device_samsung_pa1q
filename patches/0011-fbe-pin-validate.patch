+// WIP126/143: Restore button on main2 -> check whether the live /data is protected by a
+// lockscreen credential. Runs in the CALLER thread so gui_changePage is safe. If decrypt.sh
+// has not finished yet (/tmp/.decrypt_done absent) do nothing (button inert until ready). If CE
+// is already unlocked (/tmp/.ce_sp) skip straight to the restore folder picker. Else, if the
+// live spblob carries a .pwd protector, CE is locked -> prompt for the PIN (mode=0=restore).
+// Biometric-only / no-lock -> straight to restore.
+int GUIAction::fbe_restore_pin_check(std::string arg __unused)
+{
+	if (!TWFunc::Path_Exists("/tmp/.decrypt_done")) {
+		LOGINFO("WIP129: fbe_restore_pin_check: decrypt not done yet\n");
+		return 0;
+	}
+	DataManager::SetValue("tw_fbe_pin", "");
+	DataManager::SetValue("tw_password_fail", 0);
+	// WIP150: scan the LIVE spblob for a credential FIRST, on EVERY button press. This must
+	// run before the /tmp/.ce_sp shortcut: .ce_sp is a tmpfs marker cached after a prior CE
+	// unlock, but if the user Format-Data'd meanwhile the spblob (and its .pwd) is gone while
+	// the stale .ce_sp lingers - the old order took the .ce_sp path and skipped the (now
+	// wiped) credential check, which is fine, but if instead there is genuinely no credential
+	// we must drop the stale marker so later logic is consistent. No spblob dir or no .pwd =
+	// no lockscreen credential (Format Data / biometric-only / never set) -> proceed with NO
+	// PIN. Only when a real .pwd exists do we consult the .ce_sp cache or prompt.
+	bool has_credential = false;
+	DIR* dir = opendir("/data/system_de/0/spblob");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			size_t len = strlen(ent->d_name);
+			if (len > 4 && strcmp(ent->d_name + len - 4, ".pwd") == 0) {
+				has_credential = true;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	if (!has_credential) {
+		unlink("/tmp/.ce_sp");  // drop stale unlock marker (e.g. after Format Data)
+		LOGINFO("WIP150: fbe_restore_pin_check: no live credential -> restore (no PIN)\n");
+		gui_changePage("restore");
+		return 0;
+	}
+	if (TWFunc::Path_Exists("/tmp/.ce_sp")) {
+		LOGINFO("WIP129: fbe_restore_pin_check: CE unlocked -> restore\n");
+		gui_changePage("restore");
+		return 0;
+	}
+	DataManager::SetValue("tw_fbe_pin_mode", 0); // 0 = restore
+	LOGINFO("WIP129: fbe_restore_pin_check: credential found -> PIN page\n");
+	gui_changePage("fbe_restore_pin");
+	return 0;
+}
+
+// WIP126/143: Backup button on main2 -> same logic as restore but mode=1=backup, routing to
+// the fbe_backup_pin page (locked) or the backup partition picker (unlocked/no credential).
+int GUIAction::fbe_backup_pin_check(std::string arg __unused)
+{
+	if (!TWFunc::Path_Exists("/tmp/.decrypt_done")) {
+		LOGINFO("WIP129: fbe_backup_pin_check: decrypt not done yet\n");
+		return 0;
+	}
+	DataManager::SetValue("tw_fbe_pin", "");
+	DataManager::SetValue("tw_password_fail", 0);
+	// WIP150: scan the LIVE spblob FIRST, on every button press. After a Format Data the
+	// spblob (and its *.pwd) is gone but a stale /tmp/.ce_sp from an earlier unlock may still
+	// sit in tmpfs - the old order checked .ce_sp first and wrongly skipped straight in. So:
+	// no credential on disk now (Format Data / biometric-only / no lock) -> drop any stale
+	// .ce_sp and proceed WITHOUT a PIN. Only if a real .pwd credential exists do we then honour
+	// the .ce_sp unlock cache, else prompt for the PIN.
+	bool has_credential = false;
+	DIR* dir = opendir("/data/system_de/0/spblob");
+	if (dir) {
+		struct dirent* ent;
+		while ((ent = readdir(dir)) != NULL) {
+			size_t len = strlen(ent->d_name);
+			if (len > 4 && strcmp(ent->d_name + len - 4, ".pwd") == 0) {
+				has_credential = true;
+				break;
+			}
+		}
+		closedir(dir);
+	}
+	if (!has_credential) {
+		unlink("/tmp/.ce_sp");  // drop stale unlock marker (e.g. after Format Data)
+		LOGINFO("WIP150: fbe_backup_pin_check: no live credential -> backup (no PIN)\n");
+		gui_changePage("backup");
+		return 0;
+	}
+	if (TWFunc::Path_Exists("/tmp/.ce_sp")) {
+		LOGINFO("WIP126: fbe_backup_pin_check: CE already unlocked -> backup\n");
+		gui_changePage("backup");
+		return 0;
+	}
+	DataManager::SetValue("tw_fbe_pin_mode", 1); // 1 = backup
+	LOGINFO("WIP126: fbe_backup_pin_check: credential present -> PIN page\n");
+	gui_changePage("fbe_backup_pin");
+	return 0;
+}
+
+// WIP126/143: validate the PIN/password from fbe_restore_pin or fbe_backup_pin against the
+// LIVE /data via the password helper. rc==0 -> route by tw_fbe_pin_mode (0=restore picker,
+// 1=backup picker); rc!=0 -> set tw_password_fail=1 and stay on the page. Empty PIN -> error
+// without calling the helper. Scrub the PIN afterwards.
+int GUIAction::fbe_pin_validate(std::string arg __unused)
+{
+	string pin;
+	DataManager::GetValue("tw_fbe_pin", pin);
+	if (pin.empty()) {
+		LOGINFO("WIP139: fbe_pin_validate: empty PIN -> error\n");
+		DataManager::SetValue("tw_password_fail", 1);
+		DataManager::SetValue("tw_fbe_pin_display", "");
+		return 0;
+	}
+	string escaped;
+	for (size_t i = 0; i < pin.size(); ++i) {
+		if (pin[i] == '\'') escaped += "'\\''";
+		else escaped += pin[i];
+	}
+	LOGINFO("WIP126: fbe_pin_validate: validating credential (len=%zu)\n", pin.size());
+	int rc = TWFunc::Exec_Cmd("/system/bin/password '" + escaped + "'", true);
+	if (rc == 0) {
+		DataManager::SetValue("tw_password_fail", 0);
+		DataManager::SetValue(TW_IS_DECRYPTED, 1);
+		int mode = 0;
+		DataManager::GetValue("tw_fbe_pin_mode", mode);
+		LOGINFO("WIP126: fbe_pin_validate: OK (mode=%d)\n", mode);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+		// mode=0 = restore picker, mode=1 = backup picker, mode=2 = restore after prep
+		if (mode == 2)
+			gui_changePage("restore_run");
+		else if (mode == 0)
+			gui_changePage("restore");
+		else
+			gui_changePage("backup");
+	} else {
+		DataManager::SetValue("tw_password_fail", 1);
+		LOGINFO("WIP126: fbe_pin_validate: WRONG PIN (rc=%d) -> stay\n", rc);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+		DataManager::SetValue("tw_fbe_pin_display", "");
+	}
+	return 0;
+}
