 }
 
+// WIP126: Decide whether a restore needs a lockscreen credential before it starts.
+// Identical to fbe_pin_check but routes to fbe_restore_pin on match (mode=0 for restore).
+// WIP129: fbe_restore_pin_check
+int GUIAction::fbe_restore_pin_check(std::string arg __unused)
+{
+	if (!TWFunc::Path_Exists("/sbin/decrypt.sh")) {
+		LOGINFO("WIP129: fbe_restore_pin_check: decrypt.sh not ready yet\n");
+		gui_changePage("restore_run");
+		return 0;
+	}
+	if (TWFunc::Path_Exists("/tmp/.ce_sp")) {
+		LOGINFO("WIP129: fbe_restore_pin_check: CE unlocked -> restore\n");
+		gui_changePage("restore_run");
+		return 0;
+	}
+	string Restore_Path;
+	DataManager::GetValue("tw_restore", Restore_Path);
+	DataManager::SetValue("tw_fbe_pin", "");
+	DataManager::SetValue("tw_fbe_need_pin", 0);
+	bool need_pin = false;
+	{
+		string cmd =
+			"for f in '" + Restore_Path + "'/data.f2fs.win '" + Restore_Path + "'/data.f2fs.win[0-9][0-9][0-9]; do "
+			"[ -f \"$f\" ] || continue; "
+			"tar -tf \"$f\" 2>/dev/null | grep -m1 -E 'spblob/[^/]*\\.pwd$' && break; "
+			"done";
+		string result;
+		TWFunc::Exec_Cmd(cmd, result, false);
+		if (!result.empty()) {
+			need_pin = true;
+			LOGINFO("WIP129: fbe_restore_pin_check: credential found\n");
+		} else {
+			LOGINFO("WIP129: fbe_restore_pin_check: no credential\n");
+		}
+	}
+	if (need_pin) {
+		DataManager::SetValue("tw_fbe_need_pin", 1);
+		DataManager::SetValue("tw_password_fail", 0);
+		DataManager::SetValue("tw_fbe_pin_mode", 0);
+		gui_changePage("fbe_restore_pin");
+	} else {
+		gui_changePage("restore_run");
+	}
+	return 0;
+}
+
+int GUIAction::fbe_backup_pin_check(std::string arg __unused)
+{
+	if (!TWFunc::Path_Exists("/sbin/decrypt.sh")) {
+		LOGINFO("WIP129: fbe_backup_pin_check: decrypt.sh not ready yet\n");
+		gui_changePage("backup_run");
+		return 0;
+	}
+	if (TWFunc::Path_Exists("/tmp/.ce_sp")) {
+		LOGINFO("WIP126: fbe_backup_pin_check: CE already unlocked -> backup\n");
+		gui_changePage("backup_run");
+		return 0;
+	}
+	bool cred_present = false;
+	{
+		string result;
+		TWFunc::Exec_Cmd("ls /data/system_ce/0/spblob/*.pwd 2>/dev/null | head -n1", result, false);
+		if (!result.empty()) {
+			cred_present = true;
+		}
+	}
+	if (cred_present) {
+		DataManager::SetValue("tw_fbe_pin", "");
+		DataManager::SetValue("tw_password_fail", 0);
+		DataManager::SetValue("tw_fbe_pin_mode", 1);
+		LOGINFO("WIP126: fbe_backup_pin_check: credential present -> PIN page\n");
+		gui_changePage("fbe_backup_pin");
+	} else {
+		LOGINFO("WIP126: fbe_backup_pin_check: no credential -> backup\n");
+		gui_changePage("backup_run");
+	}
+	return 0;
+}
+
+// WIP126: Validate the PIN/password from fbe_restore_pin or fbe_backup_pin against the
+// device's lockscreen credential. If valid, route to restore/backup depending on mode.
+// If invalid, stay on the PIN page with an error message.
+int GUIAction::fbe_pin_validate(std::string arg __unused)
+{
+	string pin;
+	DataManager::GetValue("tw_fbe_pin", pin);
+	if (pin.empty()) {
+		LOGINFO("WIP139: fbe_pin_validate: empty PIN -> error\n");
+		DataManager::SetValue("tw_password_fail", 1);
+		DataManager::SetValue("tw_fbe_pin_display", "");
+		return 0;
+	}
+	string escaped;
+	for (size_t i = 0; i < pin.size(); ++i) {
+		if (pin[i] == '\'') escaped += "'\\''";
+		else escaped += pin[i];
+	}
+	LOGINFO("WIP126: fbe_pin_validate: validating credential (len=%zu)\n", pin.size());
+	int rc = TWFunc::Exec_Cmd("/system/bin/password '" + escaped + "'", true);
+	if (rc == 0) {
+		DataManager::SetValue("tw_password_fail", 0);
+		DataManager::SetValue(TW_IS_DECRYPTED, 1);
+		int mode = 0;
+		DataManager::GetValue("tw_fbe_pin_mode", mode);
+		LOGINFO("WIP126: fbe_pin_validate: OK (mode=%d)\n", mode);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+		// WIP139: fix inverted mode routing (mode=0 is restore, mode=1 is backup)
+		if (mode == 0)
+			gui_changePage("restore");
+		else
+			gui_changePage("backup");
+	} else {
+		DataManager::SetValue("tw_password_fail", 1);
+		LOGINFO("WIP126: fbe_pin_validate: WRONG PIN (rc=%d) -> stay\n", rc);
+		if (!pin.empty()) pin.assign(pin.size(), '*');
+		DataManager::SetValue("tw_fbe_pin", "");
+		DataManager::SetValue("tw_fbe_pin_display", "");
+	}
+	return 0;
+}
+
 int GUIAction::repair(std::string arg __unused)
 {
 	int op_status = 0;
