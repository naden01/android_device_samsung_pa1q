+// WIP165 (Plan B+): slider "Swipe to Restore" -> prepare the CE layer and validate the PIN
+// BEFORE the destructive restore. Runs in the CALLER thread so gui_changePage is safe. Calls
+// PartitionManager.Prep_Restore_For_PIN which brings up the decrypt stack, extracts the spblob
+// onto the live /data and starts hermes (marker present -> no eSE wipe). Return codes:
+//   1 = backup carries a lockscreen credential -> prompt PIN (mode=2 so a validated PIN routes
+//       on to restore_run, not the folder picker); 0 = no credential -> restore_run directly;
+//  -1 = prep failed -> show error and stay on restore_select.
+int GUIAction::fbe_restore_prep(std::string arg __unused)
+{
+	string Restore_Name;
+	DataManager::GetValue("tw_restore", Restore_Name);
+	DataManager::SetValue("tw_fbe_pin", "");
+	DataManager::SetValue("tw_password_fail", 0);
+	// No gui_msg here - keep the GUI restore log to STOCK TWRP text only. Progress/errors go to
+	// /tmp/recovery.log via LOGINFO, not to the on-screen console.
+	LOGINFO("WIP165: fbe_restore_prep: preparing encryption layer for restore...\n");
+	int need = PartitionManager.Prep_Restore_For_PIN(Restore_Name);
+	if (need < 0) {
+		LOGINFO("WIP165: fbe_restore_prep: prep FAILED - staying on restore_select\n");
+		return 0;  // stay on restore_select
+	}
+	if (need == 0) {
+		LOGINFO("WIP165: fbe_restore_prep: no credential -> restore_run\n");
+		gui_changePage("restore_run");
+		return 0;
+	}
+	DataManager::SetValue("tw_fbe_pin_mode", 2);  // 2 = restore after prep -> restore_run
+	LOGINFO("WIP165: fbe_restore_prep: credential present -> PIN page\n");
+	gui_changePage("fbe_restore_pin");
+	return 0;
+}
