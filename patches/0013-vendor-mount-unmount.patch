From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pa1q device tree <noreply@local>
Date: Wed, 24 Jul 2026 19:00:00 +0300
Subject: [PATCH] twrp: vendor unmount/flash teardown for decrypt stack

PROBLEM
  /vendor cannot be unmounted or flashed while TWRP is running. decrypt.sh mounts
  /vendor (erofs from mapper/vendor_a) and holds it via 5 daemons that mmap
  /vendor/lib64 .so files + 2 nested mounts (vintf tmpfs overlay, apnhlos firmware_mnt
  vfat). Unmount from the Mount page fails EBUSY; flashing a vendor.img fails because
  the dm-linear mapper/vendor_a is still active over the raw super region.

FIX (additive; auto-applied at build via vendorsetup, auto-revertable via git checkout)
  Two hooks in partition.cpp trigger a decrypt.sh teardown mode via
  setprop twrp.decrypt.vendor_teardown 1 (see .rc + decrypt.sh):
  - UnMount(): if /vendor is still mounted after umount2 and held by decrypt
    (/vendor/bin/qseecomd present), run teardown, wait for /tmp/.vendor_freed, retry.
  - Flash_Image(): same teardown before writing a vendor image.
  Restore decryption afterwards: setprop twrp.decrypt.run 1 (or reboot recovery).

  Files (for revert): bootable/recovery/partition.cpp
                      device tree: recovery/root/system/bin/decrypt.sh
---
--- a/partition.cpp	2026-07-24 19:40:42.751527982 +0300
+++ b/partition.cpp	2026-07-24 19:40:42.751527982 +0300
@@ -1749,6 +1749,19 @@
 			umount2(Symlink_Mount_Point.c_str(), flags);
 
 		umount2(Mount_Point.c_str(), flags);
+		// WIP131: if /vendor is still held by the decrypt stack, trigger decrypt.sh
+		// teardown (stops daemons + drops nested mounts + dm), then retry the unmount.
+		if (Is_Mounted() && Mount_Point == "/vendor" && TWFunc::Path_Exists("/vendor/bin/qseecomd")) {
+			gui_msg("vendor_teardown=Vendor held by decrypt - releasing...");
+			unlink("/tmp/.vendor_freed");
+			TWFunc::Exec_Cmd("setprop twrp.decrypt.vendor_teardown 1");
+			int vt_wait = 0;
+			while (vt_wait < 100 && !TWFunc::Path_Exists("/tmp/.vendor_freed")) {
+				usleep(100000);
+				vt_wait++;
+			}
+			umount2(Mount_Point.c_str(), flags);
+		}
 		if (Is_Mounted()) {
 			if (Display_Error)
 				gui_msg(Msg(msg::kError, "fail_unmount=Failed to unmount '{1}' ({2})")(Mount_Point)(strerror(errno)));
@@ -3303,6 +3316,19 @@
 
 	LOGINFO("Image filename is: %s\n", Backup_FileName.c_str());
 
+	// WIP131: free /vendor from the decrypt stack before flashing a vendor image,
+	// else the raw super region is busy (dm-linear mapper/vendor_a still mounted).
+	if ((Mount_Point == "/vendor" || Mount_Point == "/vendor_image") && TWFunc::Path_Exists("/vendor/bin/qseecomd")) {
+		gui_msg("vendor_teardown_flash=Releasing vendor for flashing...");
+		unlink("/tmp/.vendor_freed");
+		TWFunc::Exec_Cmd("setprop twrp.decrypt.vendor_teardown 1");
+		int vt_wait = 0;
+		while (vt_wait < 100 && !TWFunc::Path_Exists("/tmp/.vendor_freed")) {
+			usleep(100000);
+			vt_wait++;
+		}
+	}
+
 	if (Backup_Method == BM_FILES) {
 		LOGERR("Cannot flash images to file systems\n");
 		return false;
