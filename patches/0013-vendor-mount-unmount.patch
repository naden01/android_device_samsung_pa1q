From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pa1q device tree <noreply@local>
Date: Thu, 24 Jul 2026 20:00:00 +0300
Subject: [PATCH] twrp: vendor unmount/flash teardown for decrypt stack

PROBLEM
  /vendor cannot be unmounted or flashed while the decrypt stack holds it
  (5 daemons mmap /vendor/lib64 + 2 nested mounts). See decrypt.sh WIP131 block.

FIX (additive; auto-applied at build via vendorsetup, auto-revertable via git checkout)
  Two hooks in partition.cpp:
  - UnMount(): on an EXPLICIT user unmount of /vendor (Display_Error==true, GUI
    button ONLY - automatic startup/backup/restore unmounts pass false and are
    skipped so they do NOT tear down the decrypt stack and hang TWRP), trigger
    decrypt.sh teardown via setprop, wait for /tmp/.vendor_freed, retry unmount.
  - Flash_Image(): before flashing a vendor image, run the same teardown so the
    raw super region is free (dm-linear mapper/vendor_a released).
  Restore decryption afterwards: setprop twrp.decrypt.run 1 (or reboot recovery).

  Files (for revert): bootable/recovery/partition.cpp
                      device tree: recovery/root/system/bin/decrypt.sh + .rc trigger
---
--- a/partition.cpp
+++ b/partition.cpp
@@ -1749,6 +1749,20 @@
 			umount2(Symlink_Mount_Point.c_str(), flags);
 
 		umount2(Mount_Point.c_str(), flags);
+		// WIP131: only on an EXPLICIT user unmount (Display_Error==true, i.e. the GUI
+		// button). Automatic unmounts at startup/backup/restore pass false and must NOT
+		// trigger the teardown (it tears down the decrypt stack -> TWRP hangs on the logo).
+		if (Is_Mounted() && Display_Error && Mount_Point == "/vendor" && TWFunc::Path_Exists("/vendor/bin/qseecomd")) {
+			gui_msg("vendor_teardown=Vendor held by decrypt - releasing...");
+			unlink("/tmp/.vendor_freed");
+			TWFunc::Exec_Cmd("setprop twrp.decrypt.vendor_teardown 1");
+			int vt_wait = 0;
+			while (vt_wait < 100 && !TWFunc::Path_Exists("/tmp/.vendor_freed")) {
+				usleep(100000);
+				vt_wait++;
+			}
+			umount2(Mount_Point.c_str(), flags);
+		}
 		if (Is_Mounted()) {
 			if (Display_Error)
 				gui_msg(Msg(msg::kError, "fail_unmount=Failed to unmount '{1}' ({2})")(Mount_Point)(strerror(errno)));
@@ -3303,6 +3317,19 @@
 
 	LOGINFO("Image filename is: %s\n", Backup_FileName.c_str());
 
+	// WIP131: free /vendor from the decrypt stack before flashing a vendor image,
+	// else the raw super region is busy (dm-linear mapper/vendor_a still mounted).
+	if ((Mount_Point == "/vendor" || Mount_Point == "/vendor_image") && TWFunc::Path_Exists("/vendor/bin/qseecomd")) {
+		gui_msg("vendor_teardown_flash=Releasing vendor for flashing...");
+		unlink("/tmp/.vendor_freed");
+		TWFunc::Exec_Cmd("setprop twrp.decrypt.vendor_teardown 1");
+		int vt_wait = 0;
+		while (vt_wait < 100 && !TWFunc::Path_Exists("/tmp/.vendor_freed")) {
+			usleep(100000);
+			vt_wait++;
+		}
+	}
+
 	if (Backup_Method == BM_FILES) {
 		LOGERR("Cannot flash images to file systems\n");
 		return false;
