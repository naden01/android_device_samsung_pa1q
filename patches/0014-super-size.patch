--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -3710,6 +3710,12 @@ void TWPartitionManager::Setup_Super_Partition() {
 	superPartition->Is_Present = true;
 	superPartition->Is_SubPartition = false;
 	superPartition->Setup_Image();
+	// WIP145: read the real super block-device size (BLKGETSIZE64 on sda31 via
+	// Find_Partition_Size, reached through Update_Size's Can_Be_Mounted==false branch).
+	// Without this the synthetic /super has Size=0 -> shows "0MB" in Backup and a dd
+	// backup would copy 0 bytes. Update_Size sets Size=Used=Backup_Size from the ioctl,
+	// so it is dynamic per device (any S25 super size) - no hardcoded value.
+	superPartition->Update_Size(true);
 	Add_Partition(superPartition);
 	PartitionManager.Output_Partition(superPartition);
 }
